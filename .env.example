# StepProbe 配置样例 —— 复制为 .env 后按需修改
# 本项目不需要任何大模型 API Key：模型能力全部经由 WorkBuddy 调用

# 数据与结果目录
STEPPROBE_DATA_DIR=./data
STEPPROBE_RESULTS_DIR=./results
STEPPROBE_CONFIG=./configs/default.yaml

# 可选：HuggingFace 镜像（国内网络环境）
# HF_ENDPOINT=https://hf-mirror.com

# 可选：HuggingFace token（仅当拉取受限数据集时需要）
# HF_TOKEN=
